# Knowledge and Information Systems (Springer, journal 10115) build.
#
# kais-article.tex and kais-esm.tex are GENERATED by ../scripts/make_kais_main.py.
# Prose is authored in that generator; every table and figure is lifted
# verbatim from paper-kbs/kbs-article.tex via ../scripts/extract_floats.py, so
# the numbers stay identical to the ones check_paper_numbers.py validates
# against artefacts/.
#
#   make regen    rebuild both documents
#   make          checks, then both PDFs
#   make zip      submission bundle (main sources only; ESM uploads separately)
#   make clean    remove build products
.PHONY: all regen check zip clean
MAIN = kais-article
SUPP = kais-esm
FIGS = $(wildcard figures/*.png)

all: check $(MAIN).pdf $(SUPP).pdf

regen:
	cd .. && python3 scripts/make_kais_main.py

check:
	cd .. && python3 scripts/check_latex.py --tex paper-kais/$(MAIN).tex \
	  --cls paper-kais/sn-jnl.cls
	cd .. && python3 scripts/check_latex.py --tex paper-kais/$(SUPP).tex
	cd .. && python3 scripts/check_paper_numbers.py
	cd .. && python3 -m pytest tests/test_kais_split.py -q

# sn-jnl.cls and sn-basic.bst are LPPL and ship here, unlike Elsevier's cas-dc.
$(MAIN).pdf: $(MAIN).tex paper.bib $(FIGS) sn-jnl.cls sn-basic.bst
	pdflatex -interaction=nonstopmode $(MAIN).tex
	bibtex $(MAIN) || true
	pdflatex -interaction=nonstopmode $(MAIN).tex
	pdflatex -interaction=nonstopmode $(MAIN).tex
	@echo "--- undefined citations/references ---"
	@grep -cE "Citation .* undefined|Reference .* undefined" $(MAIN).log || echo "  none"
	@echo "--- pages ---"
	@grep -o "([0-9]* pages" $(MAIN).log | tail -1 || true

# The supplement is a standalone article-class document with S-numbering.
$(SUPP).pdf: $(SUPP).tex $(FIGS)
	pdflatex -interaction=nonstopmode $(SUPP).tex
	pdflatex -interaction=nonstopmode $(SUPP).tex

# Springer wants the complete source including style files, plus a PDF of the
# compiled output. The ESM is uploaded as its own item, so it is not zipped in.
zip: check
	rm -f signalshap-kais.zip
	zip -qr signalshap-kais.zip $(MAIN).tex paper.bib figures/ \
	  sn-jnl.cls sn-basic.bst
	@echo "--- contents ---"
	@unzip -l signalshap-kais.zip
	@if unzip -l signalshap-kais.zip | grep -qE "\.(aux|log|bbl|blg|fls|fdb_latexmk|out|synctex)"; then \
	  echo "ERROR: build products leaked into the bundle"; exit 1; fi
	@echo "clean: editable sources only"

clean:
	rm -f *.aux *.bbl *.blg *.log *.out *.spl *.toc \
	  $(MAIN).pdf $(SUPP).pdf signalshap-kais.zip
