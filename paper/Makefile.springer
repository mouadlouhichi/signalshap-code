# Springer Nature submission build (sn-jnl.cls).
# Snapp/Editorial Manager require pdflatex-compilable sources.
.PHONY: all clean check zip
MAIN = sn-article
all: check $(MAIN).pdf
check:
	@python3 ../scripts/check_paper_numbers.py --strict
$(MAIN).pdf: $(MAIN).tex paper.bib sn-jnl.cls sn-basic.bst
	pdflatex -interaction=nonstopmode $(MAIN).tex
	bibtex $(MAIN) || true
	pdflatex -interaction=nonstopmode $(MAIN).tex
	pdflatex -interaction=nonstopmode $(MAIN).tex
	@echo "--- undefined references / citations ---"
	@grep -c "Citation.*undefined\|Reference.*undefined" $(MAIN).log || true
# Submission bundle: Springer wants a flat .zip that compiles with pdflatex.
zip: $(MAIN).pdf
	rm -f submission.zip
	zip -j submission.zip $(MAIN).tex paper.bib sn-jnl.cls sn-basic.bst \
	  ../artefacts/figures/*.png
	@echo "submission.zip ready"
clean:
	rm -f *.aux *.bbl *.blg *.log *.out *.spl $(MAIN).pdf submission.zip
